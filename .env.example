NODE_ENV=development
PORT=4000

MONGO_URL=mongodb://localhost:27017/nrapp
MONGO_DB_NAME=nrapp
REDIS_URL=redis://localhost:6379
USER_SERVICE=http://localhost:5000

# Sinh bằng: openssl rand -hex 32
JWT_SECRET=
# Web OAuth client ID. The mobile app sends an ID token whose audience is this client.
GOOGLE_WEB_CLIENT_ID=
# Có thể tách riêng; nếu bỏ trống, Auth dùng JWT_SECRET để giữ tương thích.
AUTH_INTERNAL_SECRET=
AUTH_SIGNATURE_MAX_AGE_MS=300000

Rabbitmq_Host=localhost
Rabbitmq_Port=5672
Rabbitmq_Username=guest
Rabbitmq_Password=guest

# Logging
LOG_LEVEL=info
LOG_FORMAT=pretty
DEPLOYMENT_ENVIRONMENT=development
